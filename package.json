{
	"name": "webmaster-discord",
	"main": "dist/bot.js",
	"source": "src/bot.ts",
	"repository": "https://github.com/scouting-commons/webmaster-discord",
	"packageManager": "pnpm@10.24.0",
	"license": "AGPL-3.0-only",
	"scripts": {
		"build": "rm -rf dist && tsc",
		"watch": "tsc --watch --preserveWatchOutput",
		"start": "node .",
		"dev": "pnpm build && concurrently -k -n tsc,bot -c blue,green \"npm:watch\" \"npm:start\"",
		"check": "pnpm format && pnpm types && pnpm knip",
		"types": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip --treat-config-hints-as-errors"
	},
	"dependencies": {
		"@sapphire/framework": "^5.5.1",
		"@sapphire/plugin-hmr": "^3.0.2",
		"discord.js": "^14.27.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"concurrently": "^10.0.6",
		"dotenv": "^18.0.9",
		"knip": "^6.43.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	},
	"type": "module",
	"imports": {
		"#*": "./dist/*.js"
	}
}
